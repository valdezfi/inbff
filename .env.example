# ─── Copy this file to .env.local and fill in your values ────────────────────
# cp .env.example .env.local
#
# Only AUTH_SECRET is required to run locally.
# Everything else is optional — the app degrades gracefully.

# ─── Database ──────────────────────────────────────────────────────────────────
# MySQL 8+ connection string. If unset, the app uses data/db.json (dev only).
# Format: mysql://user:password@host:3306/dbname
MYSQL_URL=
# Set to 'false' to disable SSL (required for local Docker MySQL without TLS)
MYSQL_SSL=true

# ─── Auth ───────────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# ─── App URL ────────────────────────────────────────────────────────────────────
# Full public URL of your deployment — no trailing slash.
# Used for webhook registration and email links.
# Local dev:  http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════════
# SHOPIFY INTEGRATION — NATIVE PUBLIC APP
# ═══════════════════════════════════════════════════════════════════════════════

# ── Native Shopify OAuth ────────────────────────────────────────────────────
# Create a Shopify Partner app at https://partners.shopify.com
# Set the redirect URI to: {NEXT_PUBLIC_APP_URL}/api/shopify/callback
# This is a SINGLE Shopify app that all brands install — standard SaaS pattern.
#
# Both credentials are required. Missing credentials return a configuration error.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# OAuth callback is derived from NEXT_PUBLIC_APP_URL + /api/shopify/callback.
SHOPIFY_SCOPES=read_orders,read_products

# Shopify signs orders/paid webhooks using SHOPIFY_API_SECRET. Do not set a
# separate secret for native Shopify webhooks. This legacy variable is only a
# temporary fallback for existing deployments while SHOPIFY_API_SECRET is added.
SHOPIFY_WEBHOOK_SECRET=


# Legacy Unified integration only; not used by the native connection screen.
NEXT_PUBLIC_UNIFIED_WORKSPACE_ID=
UNIFIED_API_KEY=
# Signing secret for verifying inbound Unified.to order webhooks
# (x-unified-signature header). Get it from your Unified.to workspace
# webhook settings. Required if maintaining the legacy integration.
UNIFIED_WEBHOOK_SECRET=

# ─── Stripe ─────────────────────────────────────────────────────────────────────
# Platform secret key for Stripe Connect payouts.
# Leave blank to disable Stripe — payouts will be marked manually.
STRIPE_SECRET_KEY=

# Webhook signing secret — from the Stripe dashboard → Developers → Webhooks
# OR from `stripe listen --forward-to localhost:3000/api/webhooks/stripe` in dev.
# Required: without this, the endpoint rejects all events (including in dev).
# Events handled: transfer.failed, account.updated
STRIPE_WEBHOOK_SECRET=

# ─── Mailgun ─────────────────────────────────────────────────────────────────────
# Leave blank to print emails to stdout (verification link shown in server logs).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=inBFF <no-reply@mg.yourdomain.com>
