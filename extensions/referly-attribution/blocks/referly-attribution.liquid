{% schema %}
{
  "name": "Affiliate attribution",
  "target": "body",
  "javascript": "referly-attribution.js",
  "settings": [
    { "type": "range", "id": "attribution_days", "label": "Attribution window (days)", "min": 1, "max": 365, "step": 1, "default": 30 }
  ]
}
{% endschema %}

<div id="referly-attribution-data" data-attribution-days="{{ block.settings.attribution_days }}" style="display: none;"></div>
